# ============================================================
# Linux-C Course — Debian Template
# Uso: docker build -f Dockerfile.debian -t <nombre>-debian .
# ============================================================
FROM debian:latest

# Evitar prompts interactivos
ENV DEBIAN_FRONTEND=noninteractive

# Herramientas de desarrollo base
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    cmake \
    gdb \
    valgrind \
    strace \
    ltrace \
    man-db \
    manpages-dev \
    && rm -rf /var/lib/apt/lists/*

# Directorio de trabajo
WORKDIR /app

# Copiar código fuente
COPY src/ ./src/
COPY Makefile .

# Compilar
RUN make all

# Ejecutar
CMD ["make", "run"]
